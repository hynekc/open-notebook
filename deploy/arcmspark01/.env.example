# Open Notebook na arcmspark01 – proměnné pro docker-compose.yml
# Zkopírujte do .env ve stejné složce (deploy/arcmspark01) a vyplňte.
# Soubor .env se do gitu necommituje.

# --- POVINNÉ ---------------------------------------------------------------
# Šifrovací klíč pro uložené přístupové údaje k modelům. Vygenerujte:
#   openssl rand -hex 32
# Uschovejte ho: po změně nepůjde uložené konfigurace dešifrovat.
OPEN_NOTEBOOK_ENCRYPTION_KEY=

# Heslo do webového rozhraní a API (sdílené pro všechny uživatele). Vygenerujte:
#   openssl rand -hex 16
OPEN_NOTEBOOK_PASSWORD=

# Přístup do SurrealDB (port se ven nepublikuje). Vygenerujte heslo:
#   openssl rand -hex 16
SURREAL_USER=root
SURREAL_PASSWORD=

# --- CESTY -------------------------------------------------------------------
# Data Open Notebooku (databáze, nahrané soubory, podcasty) – mimo repozitář
ON_DATA_DIR=/home/spark/open-notebook-data
# Mezipaměť modelů Hugging Face (Qwen3.8-27B-FP8 ~31 GB, bge-m3 ~2,3 GB)
HF_CACHE_DIR=/home/spark/.cache/huggingface

# --- PORTY ---------------------------------------------------------------------
UI_PORT=8502
API_PORT=5055
# vLLM jen na 127.0.0.1 arcmspark01 (pro kontroly curl)
QWEN_HOST_PORT=8010
EMBED_HOST_PORT=8011

# --- MODELY ---------------------------------------------------------------------
VLLM_IMAGE=vllm/vllm-openai:qwen38
QWEN_GPU_MEM=0.70
QWEN_MAX_MODEL_LEN=262144
QWEN_MAX_NUM_SEQS=8
# Uvažování (thinking) Qwenu: false = rychlejší odpovědi (doporučeno pro Open Notebook)
QWEN_ENABLE_THINKING=false
EMBED_GPU_MEM=0.06
# Whisper large-v3 pro přepis zvuku a videa (~3 GB vah)
WHISPER_GPU_MEM=0.05
WHISPER_HOST_PORT=8012
CCORE_AUDIO_CONCURRENCY=2

# --- OPEN NOTEBOOK ------------------------------------------------------------------
ESPERANTO_LLM_TIMEOUT=420
OPEN_NOTEBOOK_WORKER_MAX_TASKS=2
# Docling (tabulky, OCR skenovaných PDF, obrázky): true = při prvním startu stáhne několik GB
ENABLE_DOCLING=false
ON_IMAGE_TAG=local

# --- VÍCE UŽIVATELŮ (VICE-UZIVATELU.md) -------------------------------------------
# Hesla a tajemství generujte přes „openssl rand -hex …“: znak $ by docker
# compose v .env považoval za proměnnou.
# Zapnutí režimu více uživatelů (odkomentujte až podle návodu):
# COMPOSE_FILE=docker-compose.yml:docker-compose.vice-uzivatelu.yml:vice-uzivatelu/docker-compose.uzivatele.yml
# Adresa, na které uživatelé Open Notebook otevírají (záznam v DNS UCS)
ON_HOSTNAME=notebook.cajk32.lab
# Certifikát: ucs = vydaný certifikační autoritou UCS (ON_DATA_DIR/caddy/certs/notebook.crt + .key),
#             interni = vlastní CA Caddy (prohlížeče budou varovat)
TLS_REZIM=ucs
# Tajemství přihlašování (openssl rand -hex 16 – každé zvlášť)
OAUTH2_CLIENT_SECRET=
OAUTH2_COOKIE_SECRET=
# Jak dlouho platí přihlášení, než se musí uživatel přihlásit znovu
SSO_PRIHLASENI_PLATI=12h
# Přihlášení doménovým účtem z UCS (LDAP). false = jen místní účty z uzivatele.conf
LDAP_ZAPNUTO=true
LDAP_NAZEV=Doménový účet (UCS)
LDAP_HOST=ucserver.cajk32.lab:636
LDAP_BIND_DN=uid=svc-notebook,cn=users,dc=cajk32,dc=lab
LDAP_BIND_PW=
LDAP_USERS_DN=cn=users,dc=cajk32,dc=lab
# Volitelně jen členové skupiny, např.
# LDAP_FILTR=(&(objectClass=person)(memberOf=cn=notebook-uzivatele,cn=groups,dc=cajk32,dc=lab))
LDAP_FILTR=(objectClass=person)
# E-mail uživatele z LDAP pro Open Notebook = <uživatelské jméno>@LDAP_EMAIL_PRIPONA
LDAP_EMAIL_PRIPONA=cajk32.lab
# Instance uživatelů: strop paměti a souběžné úlohy na pozadí (zpracování zdrojů)
ON_INSTANCE_MEM_LIMIT=4g
ON_INSTANCE_WORKER_MAX_TASKS=1
ON_MAX_UPLOAD_MB=100
